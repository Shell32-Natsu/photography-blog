{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "photography-blog-admin",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",

	// The pages in pages/ are bundled into the Worker as text and served by it.
	// (Cloudflare's separate static-assets hosting is not used: a Worker with
	// static assets is not told who signed in through Access.)
	"rules": [{ "type": "Text", "globs": ["**/pages/*"], "fallthrough": false }],

	// The bucket holding the original photos, and the one holding thumbnails
	// under the same keys. Put your own bucket names here.
	"r2_buckets": [
		{ "binding": "PHOTOS", "bucket_name": "your-photo-bucket" },
		{ "binding": "THUMBS", "bucket_name": "your-thumbnail-bucket" }
	],

	"vars": {
		// Public addresses of the two buckets, as used in config.json.
		"PHOTO_BASE_URL": "https://photo-r2.xiadong.info",
		"THUMB_BASE_URL": "https://photo-thumbs-r2.xiadong.info",
		// Where "publish" commits config.json.
		"GITHUB_REPO": "Shell32-Natsu/photography-blog",
		"GITHUB_BRANCH": "master"
	},

	// Signing in is Cloudflare Access's job: switch it on for this Worker in
	// the dashboard (Workers & Pages > this Worker > Access). Until then the
	// Worker refuses every request. This block only affects `wrangler dev`,
	// where it stands in for a signed-in person.
	"access": {
		"dev": { "aud": "local-development", "identity": { "email": "you@localhost" } }
	},

	// Secret, set with `wrangler secret put GITHUB_TOKEN` (optional): lets
	// "publish" commit config.json to the repository.

	"observability": { "enabled": true }
}
